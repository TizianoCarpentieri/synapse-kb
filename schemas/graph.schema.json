{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synapse KB graph snapshot, draft 1",
  "type": "object",
  "required": ["schema", "edition", "macro", "micro", "notice"],
  "properties": {
    "schema": {"const": "synapse-kb-graph-1"},
    "edition": {"type": "string"},
    "notice": {"type": "string"},
    "macro": {"$ref": "#/$defs/graph"},
    "micro": {"$ref": "#/$defs/graph"}
  },
  "$defs": {
    "graph": {
      "type": "object",
      "required": ["nodes", "edges", "total_nodes", "total_edges"],
      "properties": {
        "total_nodes": {"type": "integer", "minimum": 0},
        "total_edges": {"type": "integer", "minimum": 0},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "label", "path", "line", "folder", "command"],
      "properties": {
        "id": {"type": "string"}, "label": {"type": "string"},
        "path": {"type": "string"}, "line": {"type": "integer"},
        "folder": {"type": "string"}, "command": {"type": "string"}
      }
    },
    "edge": {
      "type": "object",
      "required": ["source", "target", "kind", "cue", "anchor", "score", "origin", "count"],
      "properties": {
        "source": {"type": "string"}, "target": {"type": "string"},
        "kind": {"type": "string"}, "cue": {"type": "string"},
        "anchor": {"type": "string"}, "score": {"type": "number"},
        "origin": {"type": "string"}, "count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
